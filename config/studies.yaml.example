# San Jose Collection Studies Configuration
#
# This file defines the studies in your collection. Each study groups related
# datasets together for organization and browsing.
#
# Copy this file to your collection directory as 'studies.yaml' and customize.
#
# Example collection structure:
#   /my_collection/
#   ├── studies.yaml           <- This file
#   ├── collection_manifest.json  <- Auto-generated by add_to_collection.py
#   ├── meier_2021_ccs/
#   │   └── PXD019086_v1.0/
#   └── archives/
#       └── PXD019086_v1.0.zip

studies:
  - id: meier_2021_ccs
    title: "CCS Prediction Benchmark (Meier et al. 2021)"
    publication: "https://doi.org/10.1038/s41467-021-21352-8"
    organism: "Homo sapiens"
    description: |
      HeLa cell line timsTOF data used for CCS prediction model training.
      Reference dataset for benchmarking ion mobility prediction.
    datasets:
      - PXD019086

  - id: hela_benchmark
    title: "HeLa Proteome Benchmark"
    organism: "Homo sapiens"
    description: |
      Standard HeLa cell proteomics datasets for method validation.
    datasets:
      - PXD054321

  # Add more studies as needed:
  # - id: study_id
  #   title: "Study Title"
  #   publication: "https://doi.org/..."  # Optional
  #   organism: "Species name"
  #   description: "Study description"
  #   datasets:
  #     - PXD000001
  #     - PXD000002
